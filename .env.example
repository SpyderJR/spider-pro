# Recomendada — métricas de red TRON en vivo (sin ella, cae a valores de referencia)
TRONSCAN_API_KEY=

# Requerida para el asistente conversacional (sin ella, el chat responde con un aviso)
XAI_API_KEY=

# Opcional — reactiva la capa CryptoCompare del fallback de velas diarias
CRYPTOCOMPARE_API_KEY=

# Puerto del servidor standalone (apps/api), no aplica en Netlify
PORT=8787
