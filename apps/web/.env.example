# Opcional — habilita el inicio de sesión con Google (respaldo en la nube + sync entre
# dispositivos). Sin estas variables, la app funciona 100% en modo local — nada se rompe,
# el botón de login simplemente no aparece. Ver SETUP.md para los pasos de configuración
# en supabase.com (capa gratuita).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
